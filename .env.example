# LuminaFPM environment configuration (Volume 13 §6).
# Copy to .env and fill in real values. NEVER commit .env. Secrets are read from
# the environment only (Volume 12 §6) — no secret may live in source control.

# ── Identity / ops ──
ENVIRONMENT=development           # development | lab | staging | production
LOG_LEVEL=INFO

# ── Database (PostgreSQL only) ──
DATABASE_URL=postgresql://lumina:lumina@db:5432/lumina_fpm
POSTGRES_USER=lumina
POSTGRES_PASSWORD=change-me       # set a strong password; do not ship the default
POSTGRES_DB=lumina_fpm

# ── Broker / cache ──
REDIS_URL=redis://redis:6379/0

# ── Security (Volume 12) ──
SECRET_KEY=change-me-generate-a-long-random-string      # session/JWT signing
ENCRYPTION_KEY=                                          # Fernet key for device-credential encryption (generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
CORS_ALLOWED_ORIGINS=http://localhost:5173              # comma-separated allowlist; never "*" with credentials
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Firewall acquisition (Volume 3) ──
# Lab mode may disable TLS verification for self-signed firewall certs (V3 Table 25).
FIREWALL_TLS_VERIFY=true
ACQUISITION_RAW_DIR=/app/raw_acquisition
ACQUISITION_TIMEOUT_SECONDS=60
ACQUISITION_MAX_RETRIES=3
# Device API credentials are NOT stored here — they live encrypted in the
# device_credential table (V3 §6.2). Never put firewall tokens in env files.

# ── AI / LLM (Volume 10) — provider abstraction ──
LLM_PROVIDER=gemini              # gemini | openai | ollama
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_provider_api_key_here
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
OPENROUTER_BASE_URL=your_openrouter_base_url
OPENROUTER_API_KEY=your_openrouter_api_key
LLAMA_CPP_BASE_URL=your_llama_cpp_url

# ── CTI (Volume 9) — API-based providers ──
CTI_PROVIDER_KEYS=               # e.g. abuseipdb=...,virustotal=...,otx=... (provider-parsed)
CTI_ALLOW_INTERNAL_INDICATORS=false   # never send RFC1918/internal indicators to external providers unless true

# ── Feature flags ──
# Dark-web / Tor / Robin is future/optional only (ADR LFPM-IMPL-005); off by default.
ENABLE_DARKWEB_INTEL=false

# ── Lumina Threat Intel (LTI) & Robin Engine ──
LTI_LLM_PROVIDER=gemini
LTI_LLM_MODEL=gemini-2.5-flash
LTI_LLM_API_KEY=your_lti_llm_api_key
ROBIN_MODEL=gemini-2.5-flash
LTI_LLM_TIMEOUT_SECONDS=120
LTI_LLM_MAX_RETRIES=3

# Tor (for dark-web scraping)
LTI_TOR_SOCKS_HOST=tor
LTI_TOR_SOCKS_PORT=9050
LTI_SCRAPE_PAGE_TIMEOUT_SECONDS=60
LTI_SCAN_TOTAL_TIMEOUT_SECONDS=900

# Rate limits
LTI_RATE_LIMIT_PER_USER_HOUR=10
LTI_RATE_LIMIT_PER_TENANT_DAY=50

# Agent Router
AGENTROUTER_BASE_URL=https://agentrouter.org/
AGENTROUTER_TOKEN=your_agentrouter_token
